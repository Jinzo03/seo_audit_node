<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Résultats — <%= startUrl %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #12151a;
    --ink-soft: #3d4451;
    --slate: #6b7280;
    --paper: #f3f5f4;
    --paper-raised: #ffffff;
    --grid-line: #e2e5e3;
    --signal: #2453ff;
    --signal-dim: #e8edff;
    --pass: #1f9d6c;
    --pass-dim: #e3f6ee;
    --watch: #b8860f;
    --watch-dim: #fbf1da;
    --warn: #c5622a;
    --warn-dim: #fbe9dd;
    --fail: #c8372f;
    --fail-dim: #fbe4e2;
    --font-display: 'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: var(--font-display);
    color: var(--ink);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 8px; }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
    border-bottom: 1px solid var(--grid-line);
    background: rgba(243, 245, 244, 0.9);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
  }
  .topbar a { color: var(--ink-soft); text-decoration: none; }
  .topbar a:hover { color: var(--signal); }
  .topbar-target { color: var(--ink); }

  main { max-width: 880px; margin: 0 auto; padding: 40px 24px 64px; }

  h1 { font-size: 24px; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 4px; }
  .subtitle { font-family: var(--font-mono); font-size: 12px; color: var(--slate); margin: 0 0 28px; word-break: break-all; }
  h2 {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 40px 0 12px;
  }
  
  /* Score gauge */
  .gauge-wrap {
    display: flex;
    align-items: center;
    gap: 28px;
    background: var(--paper-raised);
    border: 1px solid var(--grid-line);
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 1px 2px rgba(18, 21, 26, 0.04), 0 8px 24px rgba(18, 21, 26, 0.05);
  }
  .gauge { width: 132px; height: 132px; flex-shrink: 0; transform: rotate(-90deg); }
  .gauge-track { fill: none; stroke: var(--grid-line); stroke-width: 9; }
  .gauge-fill { fill: none; stroke-width: 9; stroke-linecap: round; transition: stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1); }
  .gauge-green { stroke: var(--pass); } .gauge-yellow { stroke: var(--watch); }
  .gauge-orange { stroke: var(--warn); } .gauge-red { stroke: var(--fail); }
  .gauge-text { transform: rotate(90deg); transform-origin: 60px 60px; font-family: var(--font-mono); font-size: 26px; font-weight: 600; fill: var(--ink); }

  .tier-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-block;
  }
  .badge-green { background: var(--pass-dim); color: var(--pass); }
  .badge-yellow { background: var(--watch-dim); color: var(--watch); }
  .badge-orange { background: var(--warn-dim); color: var(--warn); }
  .badge-red { background: var(--fail-dim); color: var(--fail); }
  .gauge-caption { margin-top: 8px; color: var(--slate); font-size: 13px; }

  /* Sub-scores */
  .subscores { display: flex; gap: 10px; flex-wrap: wrap; }
  .subscore-card { flex: 1; min-width: 140px; background: var(--paper-raised); border: 1px solid var(--grid-line); border-radius: 8px; padding: 14px; }
  .subscore-card .label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--slate); }
  .subscore-card .value { font-family: var(--font-mono); font-size: 21px; font-weight: 600; margin-top: 4px; }
  .bar-track { background: var(--grid-line); border-radius: 3px; height: 5px; margin-top: 8px; overflow: hidden; }
  .bar-fill { background: var(--signal); height: 100%; transition: width 1s cubic-bezier(0.22, 1, 0.36, 1); }

  .not-measured {
    background: var(--paper-raised);
    border: 1px solid var(--grid-line);
    border-left: 3px solid var(--watch);
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 16px;
  }
  .not-measured.ok { border-left-color: var(--pass); }
  .not-measured code { font-family: var(--font-mono); font-size: 12px; background: var(--paper); padding: 1px 5px; border-radius: 3px; }

  /* Sparkline + history */
  .sparkline { width: 100%; height: 80px; background: var(--paper-raised); border: 1px solid var(--grid-line); border-radius: 8px; }

  table { width: 100%; min-width: 480px; border-collapse: collapse; margin-top: 10px; font-size: 13px; background: var(--paper-raised); border: 1px solid var(--grid-line); }
  th, td { border-bottom: 1px solid var(--grid-line); padding: 9px 12px; text-align: left; }
  tr:last-child td { border-bottom: none; }
  th { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); background: var(--paper); font-weight: 600; }
  td { font-family: var(--font-mono); font-size: 12.5px; }
  td:last-child { font-family: var(--font-display); font-size: 13px; }

  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--ink); }
  th.sortable::after { content: ' \2195'; color: #b8bcbf; }

  .sev-CRITICAL { color: var(--fail); font-weight: 600; }
  .sev-WARNING { color: var(--warn); font-weight: 600; }
  .sev-NOTICE { color: var(--slate); }

  .issue-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    border: 1px solid var(--grid-line);
    background: var(--paper-raised);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
  }
  .filter-btn:hover { border-color: var(--signal); }
  .filter-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }

  .back-link { display: inline-block; margin-top: 32px; font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-soft); text-decoration: none; }
  .back-link:hover { color: var(--signal); }

  @media (max-width: 560px) {
    .gauge-wrap { flex-direction: column; align-items: flex-start; }
    .subscore-card { min-width: 45%; }
  }
</style>
</head>
<body>
  <div class="topbar">
    <a href="/">&larr; audit-tool</a>
    <span class="topbar-target"><%= startUrl %></span>
  </div>

  <main>
    <h1>Résultats d'audit</h1>
    <p class="subtitle"><%= startUrl %> — <%= pages.length %> page(s) crawlée(s)</p>

    <% const labels = { crawlability: 'Crawlabilité', technical: 'Technique', performance: 'Performance', onPage: 'On-page', mobile: 'Mobile & UX' }; %>
    <% const circumference = 339.292; const targetOffset = (circumference * (1 - result.final / 100)).toFixed(2); %>
    <a class="back-link" href="/">&larr; Nouvel audit</a>
    <div class="gauge-wrap">
      <svg viewBox="0 0 120 120" class="gauge">
        <circle class="gauge-track" cx="60" cy="60" r="54" />
        <circle
          id="gaugeFill"
          class="gauge-fill gauge-<%= result.tier.color %>"
          cx="60" cy="60" r="54"
          style="stroke-dasharray: <%= circumference %>; stroke-dashoffset: <%= circumference %>;"
          data-target="<%= targetOffset %>"
        />
        <text x="60" y="60" text-anchor="middle" dominant-baseline="central" class="gauge-text"><%= result.final %></text>
      </svg>
      <div>
        <span class="tier-badge badge-<%= result.tier.color %>"><%= result.tier.level %></span>
        <div class="gauge-caption">Score sur 100, pondéré par catégorie</div>
      </div>
    </div>

    <h2>Détail par catégorie</h2>
    <div class="subscores">
      <% for (const key of Object.keys(result.percentages)) { %>
        <div class="subscore-card">
          <div class="label"><%= labels[key] %></div>
          <div class="value"><%= result.percentages[key] %>%</div>
          <div class="bar-track"><div class="bar-fill" data-target-width="<%= result.percentages[key] %>" style="width:0%"></div></div>
        </div>
      <% } %>
    </div>

    <% if (result.notYetMeasured.includes('lcp')) { %>
    <div class="not-measured">
      <strong>Note :</strong> aucun navigateur n'a pu être lancé pour cet audit (Playwright/Chromium
      indisponible sur cet environnement) — Performance et une partie de Mobile/UX n'ont pas pu être
      mesurées cette fois-ci. Valeurs neutres, aucune pénalité appliquée. Voir
      <code>src/performance/browserAudit.js</code>.
    </div>
    <% } else { %>
    <div class="not-measured ok">
      <strong>Note :</strong> Performance et Mobile/UX ont été mesurés via un échantillon de pages
      (Playwright) — détail dans la liste des problèmes ci-dessous.
    </div>
    <% } %>

    <% if (history && history.length > 1) {
      const chrono = [...history].reverse();
      const w = 800, h = 80, pad = 10;
      const scores = chrono.map((r) => r.final_score);
      const minScore = Math.max(0, Math.min(...scores) - 5);
      const maxScore = Math.min(100, Math.max(...scores) + 5);
      const range = Math.max(1, maxScore - minScore);
      const coords = chrono.map((r, i) => {
        const x = chrono.length > 1 ? pad + (i / (chrono.length - 1)) * (w - 2 * pad) : w / 2;
        const y = h - pad - ((r.final_score - minScore) / range) * (h - 2 * pad);
        return { x: x.toFixed(1), y: y.toFixed(1), score: r.final_score };
      });
      const points = coords.map((c) => `${c.x},${c.y}`).join(' ');
    %>
    <h2>Historique pour ce domaine</h2>
    <svg viewBox="0 0 <%= w %> <%= h %>" class="sparkline" preserveAspectRatio="none">
      <polyline points="<%= points %>" fill="none" stroke="#2453ff" stroke-width="2" vector-effect="non-scaling-stroke" />
      <% coords.forEach((c) => { %>
        <circle cx="<%= c.x %>" cy="<%= c.y %>" r="3" fill="#2453ff"><title><%= c.score %></title></circle>
      <% }) %>
    </svg>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Score</th><th>Niveau</th><th>Pages</th></tr></thead>
      <tbody>
        <% for (const run of history) { %>
          <tr>
            <td><%= new Date(run.run_at).toLocaleString('fr-FR') %></td>
            <td><%= run.final_score %></td>
            <td><%= run.tier_level %></td>
            <td><%= run.pages_crawled %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    </div>
    <% } %>

    <h2>Problèmes détectés</h2>
    <% const counts = { CRITICAL: 0, WARNING: 0, NOTICE: 0 };
       result.issues.forEach((i) => { counts[i.severity] = (counts[i.severity] || 0) + 1; }); %>
    <div class="issue-filters">
      <button class="filter-btn active" data-severity="ALL">Tous · <%= result.issues.length %></button>
      <button class="filter-btn" data-severity="CRITICAL">Critical · <%= counts.CRITICAL %></button>
      <button class="filter-btn" data-severity="WARNING">Warning · <%= counts.WARNING %></button>
      <button class="filter-btn" data-severity="NOTICE">Notice · <%= counts.NOTICE %></button>
    </div>

    <div class="table-wrap">
    <table id="issuesTable">
      <thead>
        <tr>
          <th class="sortable" data-sort="category">Catégorie</th>
          <th class="sortable" data-sort="severity">Sévérité</th>
          <th class="sortable" data-sort="points">Points</th>
          <th class="sortable" data-sort="text">Problème</th>
        </tr>
      </thead>
      <tbody>
        <% for (const issue of result.issues) { %>
          <tr
            data-severity="<%= issue.severity %>"
            data-category="<%= labels[issue.category] || issue.category %>"
            data-points="<%= issue.points %>"
            data-text="<%= issue.text.replace(/"/g, '&quot;') %>"
          >
            <td><%= labels[issue.category] || issue.category %></td>
            <td class="sev-<%= issue.severity %>"><%= issue.severity %></td>
            <td><%= issue.points %></td>
            <td><%= issue.text %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    </div>

    
  </main>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      requestAnimationFrame(() => {
        const gauge = document.getElementById('gaugeFill');
        if (gauge) gauge.style.strokeDashoffset = gauge.dataset.target;
        document.querySelectorAll('.bar-fill').forEach((bar) => {
          bar.style.width = bar.dataset.targetWidth + '%';
        });
      });
    });

    (function () {
      const buttons = document.querySelectorAll('.filter-btn');
      const rows = Array.from(document.querySelectorAll('#issuesTable tbody tr'));
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const sev = btn.dataset.severity;
          rows.forEach((row) => {
            row.style.display = (sev === 'ALL' || row.dataset.severity === sev) ? '' : 'none';
          });
        });
      });

      let currentSort = { key: null, dir: 1 };
      document.querySelectorAll('#issuesTable th.sortable').forEach((th) => {
        th.addEventListener('click', () => {
          const key = th.dataset.sort;
          const dir = currentSort.key === key ? -currentSort.dir : 1;
          currentSort = { key, dir };
          const tbody = document.querySelector('#issuesTable tbody');
          const sorted = rows.slice().sort((a, b) => {
            let av = a.dataset[key];
            let bv = b.dataset[key];
            if (key === 'points') { av = Number(av); bv = Number(bv); }
            if (av < bv) return -1 * dir;
            if (av > bv) return 1 * dir;
            return 0;
          });
          sorted.forEach((row) => tbody.appendChild(row));
        });
      });
    })();
  </script>
</body>
</html>
