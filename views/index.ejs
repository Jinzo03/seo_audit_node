<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Audit Site — Scoring SEO sur 100</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #12151a;
    --ink-soft: #3d4451;
    --slate: #6b7280;
    --paper: #f3f5f4;
    --paper-raised: #ffffff;
    --grid-line: #e2e5e3;
    --signal: #2453ff;
    --signal-dim: #e8edff;
    --pass: #1f9d6c;
    --font-display: 'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: var(--font-display);
    color: var(--ink);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    min-height: 100vh;
  }

  .scan-line {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--signal) 45%, var(--signal) 55%, transparent);
    opacity: 0.35;
    animation: scan-sweep 7s ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }
  @keyframes scan-sweep {
    0% { transform: translateY(0); opacity: 0; }
    8% { opacity: 0.35; }
    50% { opacity: 0.35; }
    92% { opacity: 0; }
    100% { transform: translateY(100vh); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scan-line, .status-dot { animation: none; }
  }

  .topbar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
    border-bottom: 1px solid var(--grid-line);
    background: rgba(243, 245, 244, 0.85);
    backdrop-filter: blur(4px);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-soft);
    text-transform: uppercase;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pass);
    box-shadow: 0 0 0 0 rgba(31, 157, 108, 0.5);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(31, 157, 108, 0.45); }
    70% { box-shadow: 0 0 0 6px rgba(31, 157, 108, 0); }
    100% { box-shadow: 0 0 0 0 rgba(31, 157, 108, 0); }
  }
  .topbar-tag { color: var(--slate); }

  main {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin: 0 auto;
    padding: 72px 24px 48px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--signal);
    margin: 0 0 14px;
  }

  h1 {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }

  .lede {
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 24px;
    max-width: 50ch;
  }

  .weights {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 40px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    background: var(--paper-raised);
    border: 1px solid var(--grid-line);
    border-radius: 4px;
    padding: 6px 10px;
    color: var(--ink-soft);
  }
  .chip b { color: var(--ink); font-weight: 600; }

  .panel {
    background: var(--paper-raised);
    border: 1px solid var(--grid-line);
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 1px 2px rgba(18, 21, 26, 0.04), 0 8px 24px rgba(18, 21, 26, 0.05);
  }
  .panel-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
    display: block;
    margin-bottom: 8px;
  }
  .field { margin-bottom: 20px; }
  .field:last-of-type { margin-bottom: 26px; }

  input[type="text"], input[type="number"], textarea {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 14px;
    padding: 12px 14px;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input[type="number"] { max-width: 140px; }
  textarea { min-height: 104px; resize: vertical; line-height: 1.45; }
  input::placeholder, textarea::placeholder { color: #a4a9ae; }
  input:focus, textarea:focus {
    border-color: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-dim);
  }
  .check-field {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 14px;
    border: 1px solid var(--grid-line);
    border-radius: 6px;
    background: var(--paper);
  }
  .check-field input { margin-top: 2px; accent-color: var(--signal); }
  .check-copy { display: flex; flex-direction: column; gap: 2px; }
  .check-title { font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--ink); }
  .check-hint { font-size: 12px; color: var(--slate); line-height: 1.4; }

  button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--ink);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 13px 22px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  button:hover { background: var(--signal); }
  button:active { transform: translateY(1px); }
  button:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  button .arrow { font-size: 13px; }

  .loading-view {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: none;
    place-items: center;
    padding: 24px;
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  body.audit-loading { overflow: hidden; }
  body.audit-loading .loading-view { display: grid; }
  .loading-panel {
    width: min(420px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .loading-spinner {
    width: 72px;
    height: 72px;
    border: 6px solid var(--grid-line);
    border-top-color: var(--signal);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .loading-title {
    margin: 6px 0 0;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 700;
  }
  .loading-copy {
    margin: 0;
    max-width: 38ch;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.55;
  }
  .cancel-button {
    margin-top: 8px;
    background: var(--paper-raised);
    color: var(--ink);
    border: 1px solid var(--grid-line);
  }
  .cancel-button:hover { background: var(--ink); color: #fff; }

  footer {
    position: relative;
    z-index: 2;
    max-width: 640px;
    margin: 32px auto 0;
    padding: 0 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--slate);
  }

  @media (max-width: 520px) {
    main { padding-top: 48px; }
    h1 { font-size: 27px; }
    .topbar { padding: 12px 18px; }
    .loading-title { font-size: 24px; }
  }
</style>
</head>
<body>
  <div class="scan-line" aria-hidden="true"></div>

  <div class="topbar">
    <span class="status"><span class="status-dot" aria-hidden="true"></span> Scanner prêt</span>
    <span class="topbar-tag">audit-tool</span>
  </div>

  <main>
    <p class="eyebrow">Site audit</p>
    <h1> Notez votre site sur 100.</h1>
    <p class="lede">
      Analyse un site et le note par rapport à un modèle pondéré à cinq catégories :
      crawlabilité, santé technique, performances, référencement sur la page et mobile
      &amp; UX — la même structure qu'un audit manuel suivrait.
    </p>

    <div class="weights">
      <span class="chip"><b>30%</b> Crawlabilité</span>
      <span class="chip"><b>25%</b> Technique</span>
      <span class="chip"><b>20%</b> Performance</span>
      <span class="chip"><b>15%</b> On-page</span>
      <span class="chip"><b>10%</b> Mobile &amp; UX</span>
    </div>

    <form class="panel" action="/audit" method="post" id="auditForm">
      <div class="field">
        <label class="panel-label" for="url">URL Cible</label>
        <input type="text" id="url" name="url" placeholder="https://example.com" required>
      </div>
      <div class="field">
        <label class="panel-label" for="maxPages">Nombre maximum de pages à crawler</label>
        <input type="number" id="maxPages" name="maxPages" value="20" min="1" max="200">
      </div>
      <div class="field">
        <label class="check-field" for="runGeo">
          <input type="checkbox" id="runGeo" name="runGeo">
          <span class="check-copy">
            <span class="check-title">Verifier les citations Google AI Overview</span>
            <span class="check-hint">Optionnel, hors score. Necessite <code>SERPAPI_KEY</code> et consomme jusqu'a 5 recherches SerpApi.</span>
          </span>
        </label>
      </div>
      <div class="field">
        <label class="panel-label" for="geoQueries">Requetes GEO ciblees (une par ligne, optionnel)</label>
        <textarea id="geoQueries" name="geoQueries" placeholder="meilleur logiciel audit SEO&#10;comment auditer le referencement d'un site"></textarea>
      </div>
      <button type="submit"><span class="arrow">&#9656;</span> Lancer l'analyse</button>
    </form>
  </main>

  <footer>Historique conservé par domaine · Playwright pour Performance &amp; Mobile si disponible</footer>
  <section class="loading-view" aria-live="polite" aria-hidden="true" id="loadingView">
    <div class="loading-panel">
      <div class="loading-spinner" aria-hidden="true"></div>
      <h2 class="loading-title">Audit en cours</h2>
      <p class="loading-copy">Le crawler analyse les pages, les performances et les signaux SEO. Cette etape peut prendre quelque temps.</p>
      <button type="button" class="cancel-button" id="cancelAudit">Annuler</button>
    </div>
  </section>

  <script>
    (() => {
      const form = document.getElementById('auditForm');
      const loadingView = document.getElementById('loadingView');
      const cancelButton = document.getElementById('cancelAudit');
      let controller = null;

      function showLoading() {
        document.body.classList.add('audit-loading');
        loadingView.setAttribute('aria-hidden', 'false');
      }

      function hideLoading() {
        document.body.classList.remove('audit-loading');
        loadingView.setAttribute('aria-hidden', 'true');
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        controller = new AbortController();
        showLoading();

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(new FormData(form)),
            headers: { Accept: 'application/json' },
            signal: controller.signal,
          });

          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload.error || 'Audit failed');
          window.location.href = payload.reportUrl;
        } catch (err) {
          if (err.name !== 'AbortError') alert(err.message);
          hideLoading();
        } finally {
          controller = null;
        }
      });

      cancelButton.addEventListener('click', () => {
        if (controller) controller.abort();
        hideLoading();
      });
    })();
  </script>
</body>
</html>
