<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= categoryKey %> — <%= audit.start_url %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #12151a; --ink-soft: #3d4451; --slate: #6b7280;
    --paper: #f3f5f4; --paper-raised: #ffffff; --grid-line: #e2e5e3;
    --signal: #2453ff; --signal-dim: #e8edff;
    --pass: #1f9d6c; --pass-dim: #e3f6ee;
    --watch: #b8860f; --watch-dim: #fbf1da;
    --warn: #c5622a; --warn-dim: #fbe9dd;
    --fail: #c8372f; --fail-dim: #fbe4e2;
    --font-display: 'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: var(--font-display); color: var(--ink); background-color: var(--paper);
    background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px; min-height: 100vh;
  }
  .topbar { display: flex; align-items: center; justify-content: space-between; padding: 14px 32px; border-bottom: 1px solid var(--grid-line); background: rgba(243, 245, 244, 0.9); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.05em; }
  .topbar a { color: var(--ink-soft); text-decoration: none; }
  .topbar a:hover { color: var(--signal); }

  main { max-width: 820px; margin: 0 auto; padding: 40px 24px 64px; }
  .eyebrow { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--signal); margin: 0 0 8px; }
  h1 { font-size: 24px; font-weight: 700; margin: 0 0 4px; }
  .subtitle { font-family: var(--font-mono); font-size: 12px; color: var(--slate); margin: 0 0 32px; word-break: break-all; }

  .issue-card { background: var(--paper-raised); border: 1px solid var(--grid-line); border-radius: 8px; padding: 18px 20px; margin-bottom: 14px; }
  .issue-head { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap; }
  .sev-badge { font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; padding: 3px 8px; border-radius: 4px; }
  .sev-CRITICAL { background: var(--fail-dim); color: var(--fail); }
  .sev-WARNING { background: var(--warn-dim); color: var(--warn); }
  .sev-NOTICE { background: var(--paper); color: var(--slate); }
  .issue-points { font-family: var(--font-mono); font-size: 12px; color: var(--slate); }
  .issue-text { font-size: 15px; font-weight: 600; margin: 6px 0 12px; }

  .affected-pages { display: flex; flex-direction: column; gap: 6px; }
  .affected-pages a { font-family: var(--font-mono); font-size: 12.5px; color: var(--signal); text-decoration: none; word-break: break-all; }
  .affected-pages a:hover { text-decoration: underline; }
  .site-wide { font-family: var(--font-mono); font-size: 12.5px; color: var(--slate); font-style: italic; }
  .duplicate-table-wrap { overflow-x: auto; border: 1px solid var(--grid-line); border-radius: 6px; margin-top: 12px; }
  .duplicate-table { width: 100%; min-width: 620px; border-collapse: collapse; font-size: 13px; background: var(--paper-raised); }
  .duplicate-table th, .duplicate-table td { border-bottom: 1px solid var(--grid-line); border-right: 1px solid var(--grid-line); padding: 10px 12px; text-align: left; vertical-align: top; }
  .duplicate-table tr:last-child td { border-bottom: none; }
  .duplicate-table th:last-child, .duplicate-table td:last-child { border-right: none; }
  .duplicate-table th { font-family: var(--font-mono); font-size: 11px; color: var(--ink-soft); background: var(--paper); }
  .duplicate-index { width: 48px; font-family: var(--font-mono); color: var(--ink-soft); }
  .duplicate-value { width: 42%; font-weight: 500; }
  .duplicate-urls { display: flex; flex-direction: column; gap: 6px; }
  .duplicate-urls a { font-family: var(--font-mono); font-size: 12.5px; color: var(--signal); text-decoration: none; word-break: break-all; }
  .duplicate-urls a:hover { text-decoration: underline; }

  .empty-state { background: var(--paper-raised); border: 1px solid var(--grid-line); border-radius: 8px; padding: 32px; text-align: center; color: var(--slate); font-size: 14px; }

  .category-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0 28px; }
  .category-tab { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.02em; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--grid-line); background: var(--paper-raised); color: var(--ink-soft); text-decoration: none; }
  .category-tab:hover { border-color: var(--signal); color: var(--signal); }
  .category-tab.active { background: var(--ink); color: #fff; border-color: var(--ink); }

  .actions-row { display: flex; align-items: center; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; background: var(--signal); color: #fff; border: none; border-radius: 10px; padding: 12px 20px; text-decoration: none; box-shadow: 0 1px 2px rgba(36, 83, 255, 0.15), 0 4px 12px rgba(36, 83, 255, 0.22); }
  .btn:hover { background: #1c40d9; }
  .btn-secondary { background: var(--paper-raised); color: var(--ink); border: 1px solid var(--grid-line); box-shadow: none; }
  .btn-secondary:hover { background: var(--paper-raised); border-color: var(--signal); color: var(--signal); }
</style>
</head>
<body>
  <div class="topbar">
    <a href="/report/<%= auditId %>">&larr; audit-tool</a>
    <span><%= audit.start_url %></span>
  </div>

  <main>
    <% const categoryLabels = { crawlability: 'Crawlabilité', technical: 'Technique', performance: 'Performance', onPage: 'On-page', mobile: 'Mobile & UX' }; %>
    <p class="eyebrow">Détail catégorie</p>
    <h1><%= categoryLabels[categoryKey] || categoryKey %></h1>
    <p class="subtitle"><%= audit.start_url %> — audit du <%= new Date(audit.run_at).toLocaleString('fr-FR') %></p>

    <div class="category-tabs">
      <% for (const key of validKeys) { %>
        <a class="category-tab<%= key === categoryKey ? ' active' : '' %>" href="/report/<%= auditId %>/category/<%= key %>"><%= categoryLabels[key] %></a>
      <% } %>
    </div>

    <% if (items.length === 0) { %>
      <div class="empty-state">Aucun problème détecté dans cette catégorie pour cet audit.</div>
    <% } else { %>
      <% for (const item of items) { %>
        <div class="issue-card">
          <div class="issue-head">
            <span class="sev-badge sev-<%= item.severity %>"><%= { CRITICAL: 'Critique', WARNING: 'Avertissement', NOTICE: 'Remarque' }[item.severity] || item.severity %></span>
            <span class="issue-points"><%= item.points %> pts</span>
          </div>
          <div class="issue-text"><%= item.text %></div>
          <% if (item.duplicateGroups && item.duplicateGroups.length > 0) { %>
            <div class="duplicate-table-wrap">
              <table class="duplicate-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th><%= item.code === 'description_duplicate' ? 'Meta description' : 'Title' %></th>
                    <th>URLs concernés</th>
                  </tr>
                </thead>
                <tbody>
                  <% item.duplicateGroups.forEach((group, index) => { %>
                    <tr>
                      <td class="duplicate-index"><%= index + 1 %>.</td>
                      <td class="duplicate-value"><%= group.value %></td>
                      <td>
                        <div class="duplicate-urls">
                          <% for (const url of group.pages) { %>
                            <a href="<%= url %>" target="_blank" rel="noopener">&#8599; <%= url %></a>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else if (item.pages && item.pages.length > 0) { %>
            <div class="affected-pages">
              <% for (const url of item.pages) { %>
                <a href="<%= url %>" target="_blank" rel="noopener">&#8599; <%= url %></a>
              <% } %>
            </div>
          <% } else { %>
            <div class="site-wide">Concerne l'ensemble du site, pas une page en particulier.</div>
          <% } %>
        </div>
      <% } %>
    <% } %>

    <div class="actions-row">
      <a class="btn" href="/report/<%= auditId %>">&larr; Retour aux résultats</a>
      <a class="btn btn-secondary" href="/">Nouvel audit</a>
    </div>
  </main>
</body>
</html>
